---
import { profile } from "../data/profile";

const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a href="#inicio" class="text-lg font-bold tracking-tight">
      {profile.name.split(" ")[0]}<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-2">
      <ul
        id="nav-menu"
        class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-border bg-bg px-4 py-3 md:static md:flex md:flex-row md:gap-1 md:border-0 md:bg-transparent md:p-0"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-accent-soft hover:text-text"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-muted transition-colors hover:bg-accent-soft hover:text-text"
        aria-label="Cambiar a modo oscuro"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="rounded-md p-2 text-muted transition-colors hover:bg-accent-soft hover:text-text md:hidden"
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById("theme-toggle")!;
  const menuBtn = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("nav-menu")!;

  const syncThemeLabel = () => {
    const dark = root.classList.contains("dark");
    themeBtn.setAttribute("aria-label", dark ? "Cambiar a modo claro" : "Cambiar a modo oscuro");
  };
  syncThemeLabel();

  themeBtn.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    syncThemeLabel();
  });

  const setMenu = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  menuBtn.addEventListener("click", () => {
    setMenu(menuBtn.getAttribute("aria-expanded") !== "true");
  });

  // Cierra el menú mobile al elegir una sección o al presionar Escape.
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuBtn.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      menuBtn.focus();
    }
  });
</script>
