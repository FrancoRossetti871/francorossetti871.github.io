---
import { projects } from "../data/profile";
---

<section id="proyectos" aria-labelledby="projects-title" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 id="projects-title" class="reveal text-3xl font-bold tracking-tight sm:text-4xl">Proyectos</h2>
  <p class="reveal mt-3 max-w-2xl text-lg text-muted">
    Trabajos de la facultad y proyectos personales donde apliqué lo que fui aprendiendo.
  </p>
  <ul class="mt-10 grid gap-6 md:grid-cols-2">
    {
      projects.map((project) => (
        <li class="reveal">
          <article class="flex h-full flex-col rounded-xl border border-border bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:border-accent hover:shadow-md">
            <h3 class="text-xl font-bold">{project.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{project.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías usadas en ${project.title}`}>
              {project.tech.map((t) => (
                <li class="rounded-md bg-accent-soft px-2.5 py-1 text-xs font-medium text-text">{t}</li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent underline-offset-4 hover:underline"
              >
                Repositorio<span class="sr-only"> de {project.title} (abre en una pestaña nueva)</span> →
              </a>
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent underline-offset-4 hover:underline"
                >
                  Demo<span class="sr-only"> de {project.title} (abre en una pestaña nueva)</span> →
                </a>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
