---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-muted sm:flex-row sm:px-6">
    <p>© {year} {profile.name}. Hecho con Astro y Tailwind CSS.</p>
    <ul class="flex gap-5">
      <li><a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub</a></li>
      <li><a href={`mailto:${profile.email}`} class="hover:text-accent">Email</a></li>
    </ul>
  </div>
</footer>
