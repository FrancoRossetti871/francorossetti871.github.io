---
import { profile } from "../data/profile";

const channels = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "GitHub", value: profile.github.replace("https://", ""), href: profile.github },
  { label: "LinkedIn", value: "Ver perfil", href: profile.linkedin },
];

const inputClass =
  "mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-text placeholder:text-muted focus:border-accent aria-[invalid=true]:border-red-600 dark:aria-[invalid=true]:border-red-400";
---

<section id="contacto" aria-labelledby="contact-title" class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2">
    <div class="reveal">
      <h2 id="contact-title" class="text-3xl font-bold tracking-tight sm:text-4xl">Contacto</h2>
      <p class="mt-3 text-lg text-muted">
        ¿Tenés una propuesta laboral o un proyecto en mente? Escribime y te respondo a la brevedad.
      </p>
      <ul class="mt-8 space-y-4">
        {
          channels.map((c) => (
            <li>
              <span class="block text-sm font-semibold tracking-wider text-muted uppercase">{c.label}</span>
              <a
                href={c.href}
                class="text-lg font-medium break-all text-accent underline-offset-4 hover:underline"
                {...(c.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {c.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form id="contact-form" class="reveal space-y-5" novalidate data-email={profile.email}>
      <div>
        <label for="name" class="font-medium">Nombre</label>
        <input id="name" name="name" type="text" autocomplete="name" required minlength="2" class={inputClass} aria-describedby="name-error" />
        <p id="name-error" class="mt-1 min-h-5 text-sm text-red-700 dark:text-red-400" aria-live="polite"></p>
      </div>
      <div>
        <label for="email" class="font-medium">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required class={inputClass} aria-describedby="email-error" />
        <p id="email-error" class="mt-1 min-h-5 text-sm text-red-700 dark:text-red-400" aria-live="polite"></p>
      </div>
      <div>
        <label for="message" class="font-medium">Mensaje</label>
        <textarea id="message" name="message" rows="5" required minlength="10" class={inputClass} aria-describedby="message-error"></textarea>
        <p id="message-error" class="mt-1 min-h-5 text-sm text-red-700 dark:text-red-400" aria-live="polite"></p>
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-accent px-5 py-3 font-semibold text-on-accent shadow-sm transition-colors hover:bg-accent-hover sm:w-auto"
      >
        Enviar mensaje
      </button>
      <p id="form-status" class="text-sm font-medium" role="status"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("form-status")!;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v.length < 2 ? "Ingresá tu nombre (mínimo 2 caracteres)." : ""),
    email: (v) => (!v ? "Ingresá tu email." : !EMAIL_RE.test(v) ? "Ingresá un email válido, por ejemplo nombre@dominio.com." : ""),
    message: (v) => (v.length < 10 ? "El mensaje debe tener al menos 10 caracteres." : ""),
  };

  const validateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = rules[field.name](field.value.trim());
    field.setAttribute("aria-invalid", String(Boolean(error)));
    document.getElementById(`${field.name}-error`)!.textContent = error;
    return !error;
  };

  const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea"));

  fields.forEach((field) => {
    field.addEventListener("blur", () => validateField(field));
    field.addEventListener("input", () => {
      if (field.getAttribute("aria-invalid") === "true") validateField(field);
    });
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const results = fields.map(validateField);
    if (results.includes(false)) {
      status.textContent = "Revisá los campos marcados.";
      fields[results.indexOf(false)].focus();
      return;
    }
    // Sitio estático: el mensaje se envía abriendo el cliente de correo del visitante.
    const data = new FormData(form);
    const subject = encodeURIComponent(`Contacto desde el portfolio: ${data.get("name")}`);
    const body = encodeURIComponent(`${data.get("message")}\n\n${data.get("name")} <${data.get("email")}>`);
    window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    status.textContent = "¡Gracias! Se abrió tu aplicación de correo con el mensaje listo para enviar.";
    form.reset();
    fields.forEach((f) => f.removeAttribute("aria-invalid"));
  });
</script>
